# devbox system-wide zsh config (/etc/zsh/zshrc).
# Applies to every interactive zsh even with an empty $HOME. Override per-user
# by creating ~/.zshrc (persists on the /home PVC).

# Prompt: user@host cwd %   (green user@host, blue path)
autoload -Uz colors && colors
setopt PROMPT_SUBST
PROMPT='%F{green}%n@%m%f %F{blue}%~%f %# '

# History (file lives in $HOME, so it persists on the /home volume)
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

# Completion
autoload -Uz compinit && compinit -d "$HOME/.zcompdump"
zstyle ':completion:*' menu select

# Sane interactive defaults
setopt AUTO_CD INTERACTIVE_COMMENTS
alias ls='ls --color=auto'
alias grep='grep --color=auto'
